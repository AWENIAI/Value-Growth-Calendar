#!/usr/bin/env bash
set -euo pipefail

project_dir="$(git rev-parse --show-toplevel)"
permit_file="/opt/awen-calendar-change-permit"

# Only the root-managed systemd service may bypass the manual approval file.
if [ "${AWEN_CALENDAR_AUTOMATION:-}" = "1" ] && [ -n "${INVOCATION_ID:-}" ]; then
  exit 0
fi

if [ ! -f "$permit_file" ]; then
  echo "BLOCKED: missing $permit_file" >&2
  echo "AI/Codex/manual project commits require explicit Awen confirmation." >&2
  exit 1
fi

if ! grep -Fqx "$project_dir" "$permit_file"; then
  echo "BLOCKED: permit file does not include $project_dir" >&2
  exit 1
fi

if ! find "$permit_file" -mmin -180 | grep -q .; then
  echo "BLOCKED: permit file is older than 180 minutes" >&2
  exit 1
fi

exit 0
